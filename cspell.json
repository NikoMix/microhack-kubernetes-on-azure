{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words", "softwareTerms", "companies", "filetypes", "node", "npm", "bash"],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.astro/**",
    "**/.git/**",
    "**/*.csv",
    "**/*.svg",
    "**/*.lock",
    "**/package-lock.json",
    "**/.cspell/project-words.txt"
  ],
  "ignoreRegExpList": [
    "/[0-9a-f]{7,40}/g",
    "/[A-Fa-f0-9]{32,}/g"
  ],
  "words": [],
  "import": []
}
