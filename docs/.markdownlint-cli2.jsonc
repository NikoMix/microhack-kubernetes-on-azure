{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "globs": [
    "*.md",
    "src/content/docs/**/*.md",
    "../challenges/**/*.md",
    "../trainer-guide/**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "../**/node_modules/**",
    "**/dist/**",
    "../**/dist/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD060": false,
    "MD024": { "siblings_only": true },
    "MD029": { "style": "ordered" },
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD026": { "punctuation": ".,;:!" }
  }
}
